  BaseSys7or3b_SuppCoilHtg_Avail_Setter_Mgr,	!- Name 
  BeginTimestepBeforePredictor,	!- EnergyPlus Model Calling Point 
  BaseSys7or3b_SuppCoilHtg_Avail_Setter;	!- Program Name 1 

