EnergyManagementSystem:Sensor, 
  OutdoorDBTemp,	!- Name 
  Environment,	!-  Index Key Name 
  Site Outdoor Air Drybulb Temperature;	!- Output:Variable Name 

EnergyManagementSystem:Actuator, 
  BaseSys7or3b_SuppCoilHtg_Avail,	!- Name 
  BaseSys7or3b SuppCoilHtg AvailSch,	!- Actuated Component Unique Name 
  Schedule:Constant,	!- Actuated Component Type 
  Schedule Value;	!- Actuated Component Control Type 

EnergyManagementSystem:Actuator, 
  BaseSys7or3b_SuppCoilHtg_2_Avail,	!- Name 
  BaseSys7or3b SuppCoilHtg-2 AvailSch,	!- Actuated Component Unique Name 
  Schedule:Constant,	!- Actuated Component Type 
  Schedule Value;	!- Actuated Component Control Type 

EnergyManagementSystem:Actuator, 
  BaseSys7or3b_SuppCoilHtg_3_Avail,	!- Name 
  BaseSys7or3b SuppCoilHtg-3 AvailSch,	!- Actuated Component Unique Name 
  Schedule:Constant,	!- Actuated Component Type 
  Schedule Value;	!- Actuated Component Control Type 

EnergyManagementSystem:Actuator, 
  BaseSys7or3b_SuppCoilHtg_4_Avail,	!- Name 
  BaseSys7or3b SuppCoilHtg-4 AvailSch,	!- Actuated Component Unique Name 
  Schedule:Constant,	!- Actuated Component Type 
  Schedule Value;	!- Actuated Component Control Type 

EnergyManagementSystem:Actuator, 
  BaseSys7or3b_SuppCoilHtg_5_Avail,	!- Name 
  BaseSys7or3b SuppCoilHtg-5 AvailSch,	!- Actuated Component Unique Name 
  Schedule:Constant,	!- Actuated Component Type 
  Schedule Value;	!- Actuated Component Control Type 

EnergyManagementSystem:Program, 
  BaseSys7or3b_SuppCoilHtg_Avail_Setter,	!- Name 
  SET LockoutSetPt = ( 35.000 - 32 ) * 5 / 9,	!- Convert lock-out temp from F to C 
  IF OutdoorDBTemp >= LockoutSetPt, 
  SET BaseSys7or3b_SuppCoilHtg_Avail = 0, 
  ELSE, 
  SET BaseSys7or3b_SuppCoilHtg_Avail = 1, 
  ENDIF; 

EnergyManagementSystem:Program, 
  BaseSys7or3b_SuppCoilHtg_2_Avail_Setter,	!- Name 
  SET LockoutSetPt = ( 35.000 - 32 ) * 5 / 9,	!- Convert lock-out temp from F to C 
  IF OutdoorDBTemp >= LockoutSetPt, 
  SET BaseSys7or3b_SuppCoilHtg_2_Avail = 0, 
  ELSE, 
  SET BaseSys7or3b_SuppCoilHtg_2_Avail = 1, 
  ENDIF; 

EnergyManagementSystem:Program, 
  BaseSys7or3b_SuppCoilHtg_3_Avail_Setter,	!- Name 
  SET LockoutSetPt = ( 35.000 - 32 ) * 5 / 9,	!- Convert lock-out temp from F to C 
  IF OutdoorDBTemp >= LockoutSetPt, 
